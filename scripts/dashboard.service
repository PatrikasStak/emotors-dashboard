[Unit]
Description=Emotors Dashboard
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input
WorkingDirectory=/home/pi/EmotorsDashboard
ExecStart=/home/pi/EmotorsDashboard/scripts/run_pi.sh
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
