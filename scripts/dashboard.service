[Unit]
Description=Emotors Dashboard
After=multi-user.target can0-up.service
Wants=can0-up.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input
WorkingDirectory=/home/pi/EmotorsDashboard
ExecStart=/home/pi/EmotorsDashboard/scripts/run_pi.sh
Restart=on-failure
RestartSec=2
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
