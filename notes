---------------
0x0CF11E05
Bytes Meaning	Type	Scaling	Your code
0–1	Motor RPM	unsigned 16-bit LE	1 RPM / bit	rpm = u16 * 1.0
2–3	Motor DC current	signed 16-bit LE	0.1 A / bit	/ 10.0
4–5	Battery voltage	unsigned 16-bit LE	0.1 V / bit	/ 10.0
6–7	Error bitmask	unsigned 16-bit	bit flags	raw

0x0CF11F05
Byte	Meaning	Type	Scaling	Your code
0	Analog input 0 (ADC)	uint8	0–255 → 0–5 V	throttle_raw
1	Controller temp	uint8	°C = value − 40	-40
2	Motor temp	uint8	°C = value − 30	-30
3	Reserved	—	—	ignored
4	Controller status bits	bitfield	flags	raw
5	Switch / IO status bits	bitfield	flags	raw
6	Reserved	—	—	ignored
7	Reserved	—	—	ignored

old can reader
from __future__ import annotations

import threading
import time
from dataclasses import dataclass, field
from typing import Optional

import can

# Your observed Kelly IDs (11-bit)
ID_6E4 = 0x6E4
ID_6E5 = 0x6E5


@dataclass
class CANState:
    # Raw payloads (keep for debugging)
    raw_6e4: bytes = b""
    raw_6e5: bytes = b""

    # 6E4 interpreted as 4 little-endian 16-bit words
    w0: int = 0
    w1: int = 0
    w2: int = 0
    w3: int = 0

    # 6E5 interpreted as 4 little-endian 16-bit words
    t0: int = 0
    t1: int = 0
    t2: int = 0
    t3: int = 0

    last_update: float = field(default_factory=time.monotonic)


def _u16_le(data: bytes, off: int) -> int:
    return int.from_bytes(data[off:off + 2], "little", signed=False)


def _s16_le(data: bytes, off: int) -> int:
    return int.from_bytes(data[off:off + 2], "little", signed=True)


class CANReader:
    def __init__(self, channel: str = "can0"):
        self.channel = channel
        self._bus: Optional[can.Bus] = None
        self._t: Optional[threading.Thread] = None
        self._stop = threading.Event()
        self._lock = threading.Lock()
        self._state = CANState()

    def start(self) -> None:
        self._bus = can.interface.Bus(channel=self.channel, bustype="socketcan")

        # Filter only those two 11-bit IDs
        try:
            self._bus.set_filters([
                {"can_id": ID_6E4, "can_mask": 0x7FF, "extended": False},
                {"can_id": ID_6E5, "can_mask": 0x7FF, "extended": False},
            ])
        except Exception:
            pass

        self._t = threading.Thread(target=self._run, daemon=True)
        self._t.start()

    def stop(self) -> None:
        self._stop.set()
        if self._t:
            self._t.join(timeout=1.0)
        if self._bus:
            try:
                self._bus.shutdown()
            except Exception:
                pass

    def snapshot(self) -> CANState:
        with self._lock:
            return CANState(**self._state.__dict__)

    def _run(self) -> None:
        assert self._bus is not None

        if can_id == ID_6E4:
            page = data[0]
            print("6E4 page:", hex(page), "raw:", data.hex(), flush=True)


        while not self._stop.is_set():
            msg = self._bus.recv(timeout=0.5)
            if msg is None or len(msg.data) < 8:
                continue

            can_id = msg.arbitration_id
            data = bytes(msg.data)

            with self._lock:
                if can_id == ID_6E4:
                    self._state.raw_6e4 = data

                    # Many Kelly frames use little-endian words.
                    # We'll keep BOTH unsigned & signed interpretations available:
                    self._state.w0 = _u16_le(data, 0)
                    self._state.w1 = _s16_le(data, 2)  # current often signed
                    self._state.w2 = _u16_le(data, 4)
                    self._state.w3 = _u16_le(data, 6)

                    self._state.last_update = time.monotonic()

                elif can_id == ID_6E5:
                    self._state.raw_6e5 = data

                    self._state.t0 = _u16_le(data, 0)
                    self._state.t1 = _u16_le(data, 2)
                    self._state.t2 = _u16_le(data, 4)
                    self._state.t3 = _u16_le(data, 6)

                    self._state.last_update = time.monotonic()

